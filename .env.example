# DevShowcase API - Variáveis de Ambiente
# Porta do servidor
PORT=3000

# String de conexão do Banco de Dados PostgreSQL (Supabase ou Render)
# Formato padrão: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:sua_senha@db.exemplo.supabase.co:5432/postgres?sslmode=require"
